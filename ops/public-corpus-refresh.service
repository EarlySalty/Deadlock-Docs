[Unit]
Description=Öffentliches Community-Wissen prüfen und atomar aktualisieren
After=network-online.target dl-knowledge.service
StartLimitIntervalSec=1800
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=/home/nathanael/.local/bin/dl-corpus-refresh --knowledge-url http://127.0.0.1:8896 --base /home/nathanael/.local/share/dl-knowledge -- /bin/bash /opt/deadlock-docs/current/tools/deploy_corpus.sh --config /opt/deadlock-docs/current/ops/public-corpus-refresh.json
Restart=on-failure
RestartSec=60
TimeoutStartSec=45min
NoNewPrivileges=true
UMask=0077
